# Docker only. Does NOT connect to or deploy to your Cloudflare production Worker.
SCANNER_SECRET=replace-with-a-long-random-string
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=localhost
DEFAULT_SNI=localhost
TLS_ARGS=internal
# Host folders; the server music folder is read-only.
MUSIC_FOLDER=./music
UPLOAD_FOLDER=./uploads
MUSIC_SCAN_INTERVAL=300
